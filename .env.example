# ─── T-Invest ───────────────────────────────────────────────────
TINVEST_MCP_URL=https://invest-public-api.tbank.ru/mcp
TINVEST_REST_URL=https://invest-public-api.tbank.ru/rest

# Токены выпускаются в ЛК Т-Инвестиций: Настройки → Токены API.
# Sandbox-токен работает ТОЛЬКО через REST SandboxService (не через MCP).
TINVEST_TOKEN_SANDBOX=
# Prod-токен работает через MCP. ⚠️ Для торговли нужен уровень «полный доступ».
TINVEST_TOKEN_PROD=

# Активный контур: sandbox | prod
BACKEND=sandbox

# ─── LLM (движок предложений) ───────────────────────────────────
# Провайдер: gigachat | anthropic
LLM_PROVIDER=gigachat

# Sber GigaChat — ключ авторизации (Basic) из ЛК GigaChat API.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# Anthropic (если LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# ─── Безопасность / Guard-лимиты ────────────────────────────────
DRY_RUN=true
ALLOW_REAL_TRADING=false
MAX_ORDER_RUB=10000
MAX_POSITION_SHARE=0.25
MAX_DAILY_TURNOVER_RUB=50000

# Гейт прибыльности (окупаемость по комиссии):
COMMISSION_PCT=0.3         # комиссия за сторону, % (Инвестор=0.3, Трейдер=0.04)
SLIPPAGE_PCT=0.1           # буфер на спред/проскальзывание, %
MIN_NET_EDGE_RATIO=1.5     # тейк должен быть ≥ round-trip издержки × это

# Сохранение капитала (применяется к покупкам):
MAX_DRAWDOWN_PCT=15        # просадка от пика → стоп новых покупок (0 = выкл)
EQUITY_FLOOR_RUB=0         # ниже этого капитала покупки запрещены (напр. 2700 для депо 3000)
MAX_TOTAL_EXPOSURE_PCT=0.7 # макс. доля в бумагах (подушка кэша ≥30%)
MAX_OPEN_POSITIONS=3       # макс. число открытых позиций (0 = выкл)

# ─── Стратегия RSI mean-reversion (команда `rsi`) ───────────────
STRATEGY_ENABLED=true       # false → режим «только карри» (без спекулятивных входов)
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
RSI_TP_PCT=4
RSI_SL_PCT=3
# Лимитные заявки и ликвидность
USE_LIMIT_ORDERS=true       # marketable-limit вместо market (контроль проскальзывания)
LIMIT_SLIPPAGE_CAP_PCT=0.3  # макс. проскальзывание (потолок цены), %
MAX_SPREAD_PCT=0.5          # фильтр ликвидности: не входить при спреде шире, %

# Circuit breaker по волатильности (не входить в аномальное движение):
VOLATILITY_ENABLED=true
MAX_INTRADAY_RANGE_PCT=3    # размах за час выше → стоп входов, %

# Карри: парковка свободного кэша в фонд ликвидности (ежедневный доход по ставке):
CARRY_ENABLED=true
CARRY_UID=a240edc6-a605-44b3-9801-37b9f7c3d1ff  # LQDT «ВИМ Ликвидность»
CARRY_TICKER=LQDT
CASH_RESERVE_RUB=2000       # держим ликвидным под стратегию, остальное → в фонд

# Дивидендный фактор: покупка перед отсечкой, выход после выплаты
DIV_ENABLED=true
DIV_ENTRY_WINDOW_DAYS=10
DIV_MIN_YIELD=3
DIV_SELL_AFTER_PAYMENT=true

# ─── Планировщик (команда `loop`) ───────────────────────────────
LOOP_INTERVAL_SEC=900       # период цикла, сек (900 = 15 мин)
LOOP_MARKET_HOURS_ONLY=true # торговать только в часы биржи
LOOP_START_HOUR_MSK=10      # начало окна, МСК
LOOP_END_HOUR_MSK=24        # конец окна, МСК (24 = включая вечёрку)
LOOP_MAX_TICKS=0            # 0 = бесконечно (для тестов можно ограничить)

# ─── Подтверждение сделок ───────────────────────────────────────
# Ежедневная сводка P&L в Telegram
DAILY_REPORT_ENABLED=true
REPORT_HOUR_MSK=19

APPROVAL_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_ID=
