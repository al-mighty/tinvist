{
  "name": "tinvist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Торговый агент поверх T-Bank Invest MCP (гибрид: предложение + подтверждение)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
